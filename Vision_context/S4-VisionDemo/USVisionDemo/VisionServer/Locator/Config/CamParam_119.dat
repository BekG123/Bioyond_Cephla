#
# INTERNAL CAMERA PARAMETERS
#

# ===== generic parameter syntax ==========================================
#
# Syntax:      ParGroup: <pargroupname>;
#                        <pargroup_description>;
#
#               <name> : <shortname> : <default_value>;
#                        <type> : <lower_bound> : <upper_bound>;
#                        <description>;
#
#                [ <type> ::= BOOL|XBOOL|INT|FLOAT|DOUBLE|STRING ]
#
# =========================================================================



##############################################################################
#
#  Camera : Parameter
#    >  Focus
#    >  Poly1
#    >  Poly2
#    >  Poly3
#    >  Poly4
#    >  Poly5
#    >  Sx
#    >  Sy
#    >  Cx
#    >  Cy
#    >  ImageWidth
#    >  ImageHeight
#
##############################################################################

ParGroup: Camera: Parameter;
	"Internal camera parameters";

Focus:foc:	0.00841283402865056;
	DOUBLE:0.0:;
	"Focal length of the lens";

Poly1:poly1:	467.050729044741;
	DOUBLE::;
	"1st polynomial distortion coefficient";

Poly2:poly2:	-3612431.90854082;
	DOUBLE::;
	"2nd polynomial distortion coefficient";

Poly3:poly3:	-1520740078548.04;
	DOUBLE::;
	"3rd polynomial distortion coefficient";

Poly4:poly4:	128.203582814226;
	DOUBLE::;
	"4th polynomial distortion coefficient * 1000";

Poly5:poly5:	69.9934350008722;
	DOUBLE::;
	"5th polynomial distortion coefficient * 1000";

Sx:sx:	2.40042628032061e-006;
	DOUBLE:0.0:;
	"Width of a cell on the sensor";

Sy:sy:	2.4e-006;
	DOUBLE:0.0:;
	"Height of a cell on the sensor";

Cx:cx:	1529.68698242068;
	DOUBLE::;
	"X-coordinate of the image center";

Cy:cy:	1038.79206532811;
	DOUBLE::;
	"Y-coordinate of the image center";

ImageWidth:imgw:	3072;
	INT:1:32768;
	"Width of the images";

ImageHeight:imgh:	2048;
	INT:1:32768;
	"Height of the images";


